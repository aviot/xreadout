{
  "manifest_version": 3,
  "name": "X Pro Readout",
  "version": "1.0.0",
  "description": "Auto read new posts on X Pro using browser speech synthesis.",
  "permissions": ["storage"],
  "host_permissions": ["https://pro.x.com/*"],
  "content_scripts": [
    {
      "matches": ["https://pro.x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "X Pro Readout",
    "default_popup": "popup.html"
  }
}
